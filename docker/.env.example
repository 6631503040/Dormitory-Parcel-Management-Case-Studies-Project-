# Copy to docker/.env (which is gitignored) and change the values.
POSTGRES_DB=dpms
POSTGRES_USER=dpms
POSTGRES_PASSWORD=change-me-dev-only
# 32+ characters; signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me
APP_ENV=development
COOKIE_SECURE=false
API_PORT=8080
DB_PORT=5432

# Optional — LINE Official Account "Messaging API" settings page. Leave both blank to run without
# the LINE Check-Parcel/OTP feature (the webhook then returns LINE_NOT_CONFIGURED).
# Channel secret: verifies that a webhook call really came from LINE (X-Line-Signature).
LINE_CHANNEL_SECRET=
# Channel access token: lets the backend send reply messages back to residents. Issued separately
# from the channel secret — on the same Messaging API settings page, usually below it ("Issue").
LINE_CHANNEL_ACCESS_TOKEN=
