# Copy to docker/.env (which is gitignored) and change the values.
POSTGRES_DB=dpms
POSTGRES_USER=dpms
POSTGRES_PASSWORD=change-me-dev-only
# 32+ characters; signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me
APP_ENV=development
COOKIE_SECURE=false
API_PORT=8080
DB_PORT=5432

# Optional — Web Push notifications for Residents (the PWA at /resident/). Leave the keys blank to
# run without it (resident routes then return PUSH_NOT_CONFIGURED; Check-In is unaffected).
# Generate a key pair once:  docker compose run --rm backend /app/vapidkeys
# (or, with Go installed:     cd backend && go run ./cmd/vapidkeys)
# Keep the private key secret. Changing the pair means every Resident has to register again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the browser push services can reach if something goes wrong: mailto: or https:// URL.
VAPID_SUBJECT=mailto:parcel-desk@example.com
# Parcels for the same room checked in within this many seconds go out as one notification.
PUSH_BATCH_WINDOW_SECONDS=60
